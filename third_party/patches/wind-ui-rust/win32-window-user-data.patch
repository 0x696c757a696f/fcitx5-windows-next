diff --git a/src/platform/win32/mod.rs b/src/platform/win32/mod.rs
index b96a3d7..d292644 100644
--- a/src/platform/win32/mod.rs
+++ b/src/platform/win32/mod.rs
@@ -353,7 +353,10 @@ unsafe extern "system" fn app_host_proc(
         WM_NCCREATE => {
             let cs = lparam.0 as *const CREATESTRUCTW;
             if !cs.is_null() {
