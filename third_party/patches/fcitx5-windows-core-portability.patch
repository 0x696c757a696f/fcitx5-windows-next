+// The Windows frontend installs each optional package into its own prefix and
+// lists the active prefixes in FCITX_PACKAGE_PREFIXES.  A prefix mirrors the
+// built-in layout, so its directories are searched after the built-in ones.
+const std::vector<std::filesystem::path> &packagePrefixes() {
+    static const std::vector<std::filesystem::path> prefixes = []() {
+        std::vector<std::filesystem::path> result;
+        const auto value = getEnvironment("FCITX_PACKAGE_PREFIXES");
+        if (!value) {
+            return result;
+        }
+        for (const auto &dir :
+             stringutils::split(*value, std::string_view{";"})) {
+            if (dir.empty()) {
+                continue;
+            }
+            auto path = utf8::UTF8ToUTF16(dir);
+            normalizeSlash(path);
+            result.push_back(std::filesystem::path(path).lexically_normal());
+        }
+        return result;
+    }();
+    return prefixes;
+}
+
+void appendPackagePaths(std::vector<std::filesystem::path> &paths,
+                        const std::filesystem::path &subPath) {
+    for (const auto &prefix : packagePrefixes()) {
+        paths.push_back(prefix / subPath);
+    }
+}
