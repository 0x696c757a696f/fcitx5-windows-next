#pragma once

#include <cstddef>
#include <string_view>

#include <fcitx5_windows/release_identity.h>

extern "C" {
const unsigned char* fcitx5_windows_common_version();
std::size_t fcitx5_windows_common_version_len();
const unsigned char* fcitx5_windows_common_release_channel();
std::size_t fcitx5_windows_common_release_channel_len();
unsigned int fcitx5_windows_common_architecture();
}

namespace fcitx::windows {

inline constexpr std::string_view kVersion = "@PROJECT_VERSION@";

enum class Architecture {
    x86,
    x64,
};

[[nodiscard]] inline std::string_view version() noexcept {
    return {reinterpret_cast<const char*>(fcitx5_windows_common_version()),
            fcitx5_windows_common_version_len()};
}

[[nodiscard]] inline Architecture architecture() noexcept {
    return fcitx5_windows_common_architecture() == 1 ? Architecture::x64
                                                     : Architecture::x86;
}

[[nodiscard]] inline std::string_view release_channel() noexcept {
    return {reinterpret_cast<const char*>(
                fcitx5_windows_common_release_channel()),
            fcitx5_windows_common_release_channel_len()};
}

} // namespace fcitx::windows
