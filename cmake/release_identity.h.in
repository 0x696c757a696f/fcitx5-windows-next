#pragma once

#include <guiddef.h>

#include <array>
#include <string_view>

namespace fcitx::windows {

enum class ReleaseChannel { stable, beta, nightly };

struct ReleaseIdentity {
  ReleaseChannel channel;
  std::string_view channel_name;
  GUID text_service_clsid;
  GUID language_profile_guid;
  GUID notification_icon_guid;
  const wchar_t* service_description;
  const wchar_t* pipe_prefix;
  const wchar_t* local_object_prefix;
  const wchar_t* data_directory;
  const wchar_t* registry_value;
  const wchar_t* installer_app_id;
};

